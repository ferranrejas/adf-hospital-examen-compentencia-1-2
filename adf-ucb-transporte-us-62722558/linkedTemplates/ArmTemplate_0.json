			"properties": {
				"folder": {
					"name": "oro"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "sql_silver_admisiones",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sql_gold_admisiones",
								"type": "DatasetReference"
							},

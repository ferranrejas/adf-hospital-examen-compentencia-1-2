{
	"name": "df_silver_diagnositcos",
	"properties": {
		"folder": {
			"name": "plata"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronce_diagnosticos",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_silver_admisiones",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_diagnosticos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exist1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          diagnosis_description as string,",
				"          severity as string,",
				"          icd_code as string,",
				"          n as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT b.diagnosis_id, b.admission_id, b.diagnosis_description, b.severity, LTRIM(RTRIM(s.value)) AS icd_code, ROW_NUMBER() OVER (PARTITION BY b.diagnosis_id ORDER BY s.value) AS n FROM bronze.diagnoses b CROSS APPLY STRING_SPLIT(b.icd_code, CHAR(44)) s WHERE LEN(LTRIM(RTRIM(s.value))) > 0',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          adm_ref as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT admission_id AS adm_ref FROM silver.admissions',",
				"     format: 'query') ~> source2",
				"source1 derive(diagnosis_id = toInteger(toInteger(trim(diagnosis_id)) + 100000*(n-1)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          severity = case(lower(trim(severity))=='mild','Mild', lower(trim(severity))=='moderate','Moderate', lower(trim(severity))=='severe','Severe', lower(trim(severity))=='critical','Critical', toString(null())),",
				"          icd_code = iif(length(upper(regexReplace(icd_code,'[ .-]','')))>3, concat(left(upper(regexReplace(icd_code,'[ .-]','')),3),'.',substring(upper(regexReplace(icd_code,'[ .-]','')),4,10)), upper(regexReplace(icd_code,'[ .-]','')))) ~> derivedColumn1",
				"derivedColumn1, source2 lookup(admission_id == adm_ref,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> exist1",
				"exist1 filter(!isNull(diagnosis_id) && !isNull(adm_ref) && regexMatch(icd_code,'[A-Z][0-9]{2}([.][0-9A-Z]{1,4})?')) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}